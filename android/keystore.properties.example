# Copy to keystore.properties (git-ignored) and fill in your own release key.
# Create a key once with:
#   keytool -genkeypair -v -keystore muslimday-release.jks -alias muslimday -keyalg RSA -keysize 2048 -validity 10000
# Keep the .jks file and these passwords safe: every Play Store update must be signed with the same key.
storeFile=muslimday-release.jks
storePassword=CHANGE_ME
keyAlias=muslimday
keyPassword=CHANGE_ME
